{
  "name": "docuservice",
  "version": "0.2.0",
  "description": "Turn a folder of Markdown files in Azure Repos into a published Azure Static Web App. Zero config.",
  "type": "module",
  "bin": {
    "docuservice": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "azure",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-theme.js",
    "dev": "npm run build && node dist/cli.js serve examples/docs",
    "demo": "npm run build && node dist/cli.js build examples/docs",
    "test": "npm run build && node --test \"tests/**/*.test.js\"",
    "prepublishOnly": "npm run build && npm test",
    "ext:build": "npm --prefix extension/DocuServiceBuild install && npm --prefix extension/DocuServiceBuild run build",
    "ext:stage": "node extension/scripts/stage.mjs",
    "ext:package": "npm run ext:build && npm run ext:stage && tfx extension create --root extension --manifest-globs vss-extension.json --output-path extension/dist",
    "ext:icon": "node extension/scripts/make-icon.mjs"
  },
  "keywords": [
    "markdown",
    "documentation",
    "azure",
    "static-web-apps",
    "azure-devops",
    "azure-repos",
    "docs-as-code"
  ],
  "license": "MIT",
  "dependencies": {
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tfx-cli": "^0.24.0",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imjkrao/docuService.git"
  },
  "bugs": {
    "url": "https://github.com/imjkrao/docuService/issues"
  },
  "homepage": "https://github.com/imjkrao/docuService#readme"
}
